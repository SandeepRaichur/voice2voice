# ==============================================================================
# Voice2Voice AI Agent - Ultra-Low Latency Environment Configuration
# ==============================================================================

# Server Settings
HOST=127.0.0.1
PORT=3000
DEBUG=false

# ------------------------------------------------------------------------------
# AI Provider: 'gemini' (Free Tier Cloud API) or 'ollama' (100% Offline Local)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
FALLBACK_TO_OLLAMA=true

# Google Gemini Settings (Free Tier key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama Local Brain Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=120

# ------------------------------------------------------------------------------
# Speech-to-Text (faster-whisper)
# ------------------------------------------------------------------------------
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Greedy decoding (beam_size=1) is 3-4x faster than beam_size=5 on CPU
WHISPER_BEAM_SIZE=1

# ------------------------------------------------------------------------------
# Conversational VAD Turn Detection
# ------------------------------------------------------------------------------
# Silence delay before turn finalization in ms (500ms recommended for natural flow)
REALTIME_VAD_SILENCE_MS=500

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS)
# ------------------------------------------------------------------------------
# Options:
# - 'edge-tts' (Ultra-low latency streaming neural voices, ~500ms TTFA, natural Indian English)
# - 'pyttsx3' (100% Offline Windows SAPI5 system voices)
TTS_ENGINE=edge-tts
EDGE_TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_RATE=180
TTS_VOICE_VOLUME=1.0

# ------------------------------------------------------------------------------
# Voice Emotion Recognition
# ------------------------------------------------------------------------------
# When FALSE, uses instantaneous acoustic heuristic (<2ms) without blocking
# When TRUE, runs async background classification using the 95M Wav2Vec2 model
EMOTION_ENABLED=false
EMOTION_MODEL_NAME=superb/wav2vec2-base-superb-er
EMOTION_CONFIDENCE_THRESHOLD=0.55
